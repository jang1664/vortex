#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

CONFIGS="${CONFIGS:-""}"
CONFIGS+=" -DMEM_ADDR_WIDTH=34 -DPLATFORM_MEMORY_ADDR_WIDTH=34 -DPLATFORM_MEMORY_NUM_BANKS=32 -DPLATFORM_MERGED_MEMORY_INTERFACE"
CONFIGS+=" -DFPU_FPNEW"
CONFIGS+=" -DDCACHE_DISABLE -DL2_ENABLE -DNUM_THREADS=8"
CONFIGS+=" -DLMEM_LOG_SIZE=22 -DSTACK_BASE_ADDR=8585740288"
# CONFIGS+="-DEXT_TCU_ENABLE"

PREFIX="${PREFIX:-core1_ila_tcu}" \
PLATFORM="${PLATFORM:-xilinx_u55c_gen3x16_xdma_3_202210_1}" \
NUM_CORES="${NUM_CORES:-1}" \
CONFIGS="${CONFIGS}" \
TARGET=hw_emu \
DEBUG=3 \
make -C "${SCRIPT_DIR}" 2>&1 | tee "${LOG_FILE:-core1_ila_tcu.log}"
