#!/bin/bash

set -o pipefail

PREFIX=build_u55c_fpnew_denable_core1_ila \
PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1 \
NUM_CORES=1 \
CONFIGS="-DFPU_FPNEW" \
TARGET=hw \
DEBUG=1 \
CLOCK_FREQ_HZ=60 \
make 2>&1 | tee build_u55c_fpnew_denable_core1_ila.log

PREFIX=core1_ila_tcu \
PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1 \
NUM_CORES=1 \
CONFIGS="-DFPU_FPNEW -DEXT_TCU_ENABLE" \
TARGET=hw \
DEBUG=1 \
CLOCK_FREQ_HZ=60 \
make 2>&1 | tee core1_ila_tcu.log