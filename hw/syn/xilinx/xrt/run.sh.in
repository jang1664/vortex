#!/bin/bash

set -o pipefail

# CONFIGS="${CONFIGS:--DEXT_TCU_ENABLE}"
#"-DEXT_TCU_ENABLE -DDCACHE_DISABLE -DL2_ENABLE -DNUM_THREADS=32 -DLMEM_LOG_SIZE=19 -DSTACK_BASE_ADDR=64\'h1FFF80000"
#CONFIGS="-DDCACHE_DISABLE -DNUM_THREADS=32 -DLMEM_LOG_SIZE=22 -DSTACK_BASE_ADDR=64\'h1FFC00000" \

PREFIX=ugr2_c1_f100_fpint \
PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1 \
NUM_CORES=1 \
CONFIGS="-DDCACHE_DISABLE -DL2_ENABLE -DNUM_THREADS=8 -DLMEM_LOG_SIZE=22 -DSTACK_BASE_ADDR=64\'h1FFC00000" \
TARGET=hw \
DEBUG=1 \
PERF=1 \
CLOCK_FREQ_HZ=100 \
make 2>&1 | tee ugr2_c1_f100_fpint.log