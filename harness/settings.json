{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test \"$CONDA_DEFAULT_ENV\" = 'vortex' || echo 'BLOCK: conda env \"vortex\"가 활성화되어 있지 않습니다. `conda activate vortex`를 먼저 실행하세요.'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/hooks/check_interface_consistency.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/hooks/check_cmd_consistency.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
