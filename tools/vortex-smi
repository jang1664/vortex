#!/usr/bin/env python3
"""
vortex-smi: Vortex GPGPU System Management Interface

A monitoring tool for Vortex GPGPU on Xilinx FPGAs, similar to nvidia-smi.
Reads live status from shared memory exported by the Vortex XRT runtime.

Usage:
  vortex-smi              # one-shot status display (includes board power on HW)
  vortex-smi -l [SEC]     # loop mode (default: 1s interval)
  vortex-smi -j           # JSON output
  vortex-smi --backend hw # choose backend: simx/hw_emu/hw/all
  vortex-smi --xbutil     # also query xbutil for FPGA-level info
  vortex-smi --no-power   # skip board power sampling (faster refresh in -l)
  vortex-smi --csv pwr.csv --summary -l 0.1   # power_eval-style log + summary
"""

import argparse
import ctypes
import glob
import json
import mmap
import os
import signal
import struct
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

# ─── Constants (must match vx_shm_status.h) ──────────────────────────────────

VX_SHM_MAGIC = 0x56584D53  # "VXMS"
VX_SHM_VERSION = 1
VX_SHM_MAX_BANKS = 32

STATE_NAMES = {
    0: "OFFLINE",
    1: "IDLE",
    2: "UPLOADING",
    3: "DOWNLOADING",
    4: "RUNNING",
    5: "ERROR",
}

STATE_COLORS = {
    0: "\033[90m",   # gray
    1: "\033[32m",   # green
    2: "\033[33m",   # yellow
    3: "\033[33m",   # yellow
    4: "\033[36m",   # cyan
    5: "\033[31m",   # red
}

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"


# ─── Data structures ─────────────────────────────────────────────────────────

class BankInfo(ctypes.LittleEndianStructure):
    _pack_ = 1
    _fields_ = [
        ("allocated",  ctypes.c_uint32),
        ("ref_count",  ctypes.c_uint32),
        ("bank_size",  ctypes.c_uint64),
    ]


class ShmStatus(ctypes.LittleEndianStructure):
    _pack_ = 1
    _fields_ = [
        # header
        ("magic",           ctypes.c_uint32),
        ("version",         ctypes.c_uint32),
        # device info
        ("num_cores",       ctypes.c_uint32),
        ("num_warps",       ctypes.c_uint32),
        ("num_threads",     ctypes.c_uint32),
        ("num_banks",       ctypes.c_uint32),
        ("global_mem_size", ctypes.c_uint64),
        ("device_name",     ctypes.c_char * 64),
        # runtime state
        ("state",           ctypes.c_uint32),
        ("pid",             ctypes.c_uint32),
        # memory stats
        ("mem_used",        ctypes.c_uint64),
        ("mem_free",        ctypes.c_uint64),
        # transfer stats
        ("total_uploaded",  ctypes.c_uint64),
        ("total_downloaded",ctypes.c_uint64),
        ("upload_count",    ctypes.c_uint64),
        ("download_count",  ctypes.c_uint64),
        # kernel stats
        ("kernel_launches", ctypes.c_uint64),
        ("last_kernel_addr",ctypes.c_uint64),
        ("last_kernel_name",ctypes.c_char * 64),
        # timing
        ("init_timestamp",  ctypes.c_uint64),
        ("last_activity",   ctypes.c_uint64),
        # per-bank
        ("banks",           BankInfo * VX_SHM_MAX_BANKS),
        # reserved
        ("_reserved",       ctypes.c_uint8 * 192),
    ]


# ─── Helpers ──────────────────────────────────────────────────────────────────

def human_bytes(n):
    """Format byte count in human-readable form."""
    if n < 1024:
        return f"{n} B"
    for unit in ("KiB", "MiB", "GiB", "TiB"):
        n /= 1024
        if n < 1024:
            return f"{n:.1f} {unit}"
    return f"{n:.1f} PiB"


def human_count(n):
    """Format large counts with K/M suffixes."""
    if n < 10000:
        return str(n)
    if n < 1000000:
        return f"{n/1000:.1f}K"
    return f"{n/1000000:.1f}M"


def elapsed_str(ms_timestamp):
    """Time elapsed since timestamp in human-readable form."""
    if ms_timestamp == 0:
        return "N/A"
    elapsed = time.time() - ms_timestamp / 1000.0
    if elapsed < 0:
        return "just now"
    return str(timedelta(seconds=int(elapsed)))


def pid_alive(pid):
    """Check if a PID is still running."""
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False


def candidate_shm_paths(backend="all"):
    """Return candidate shared-memory paths in lookup order."""
    forced = os.environ.get("VORTEX_SHM_PATH", "").strip()
    if forced:
        return [forced]

    uid = os.getuid()
    paths = []

    # Primary well-known path (shared by all users, like nvidia-smi)
    if backend in ("all", "hw"):
        paths.append("/dev/shm/vortex_status")

    if backend in ("all", "simx"):
        paths.append(f"/dev/shm/vortex_status_simx_uid_{uid}")

    if backend in ("all", "hw_emu"):
        paths.append(f"/dev/shm/vortex_status_xrt_emu_uid_{uid}")

    # Legacy per-BDF paths (for backward compatibility)
    if backend in ("all", "hw"):
        bdf_paths = sorted(glob.glob("/dev/shm/vortex_status_xrt_bdf_*"))
        if bdf_paths:
            paths.extend(bdf_paths)

    # stable de-dup
    return list(dict.fromkeys(paths))


def read_shm_file(shm_path):
    """Read and validate one shared-memory status file."""
    fd = None
    mm = None
    try:
        fd = os.open(shm_path, os.O_RDONLY)
        size = os.fstat(fd).st_size
        if size < ctypes.sizeof(ShmStatus):
            return None
        mm = mmap.mmap(fd, ctypes.sizeof(ShmStatus), access=mmap.ACCESS_READ)
        status = ShmStatus.from_buffer_copy(mm[:ctypes.sizeof(ShmStatus)])
        if status.magic != VX_SHM_MAGIC:
            return None
        if status.version != VX_SHM_VERSION:
            return None
        return status
    except Exception:
        return None
    finally:
        if mm is not None:
            mm.close()
        if fd is not None:
            os.close(fd)


def read_shm_candidates(backend="all"):
    """Read valid shared-memory entries. Returns list[(ShmStatus, path)]."""
    candidates = []
    for shm_path in candidate_shm_paths(backend):
        if "*" in shm_path:
            continue
        if not os.path.exists(shm_path):
            continue
        status = read_shm_file(shm_path)
        if status is not None:
            candidates.append((status, shm_path))
    return candidates


def select_best_candidate(candidates):
    """Choose one preferred shared-memory entry from candidates."""
    if not candidates:
        return None, None

    # Prefer non-offline + alive PID + recent activity.
    def rank(item):
        status, _ = item
        return (
            1 if status.state != 0 else 0,
            1 if pid_alive(status.pid) else 0,
            status.last_activity,
        )

    return max(candidates, key=rank)


def read_shm(backend="all"):
    """Read one preferred shared-memory entry. Returns (ShmStatus|None, path|None)."""
    return select_best_candidate(read_shm_candidates(backend))


# ─── Display ──────────────────────────────────────────────────────────────────

HEADER = f"""\
{BOLD}╔══════════════════════════════════════════════════════════════╗
║                     vortex-smi  v0.1                         ║
╚══════════════════════════════════════════════════════════════╝{RESET}"""


def print_status(status, color=True, shm_path=None, checked_paths=None, power_data=None):
    """Print nvidia-smi style status display."""
    if not color:
        # strip ANSI
        global RESET, BOLD, DIM
        RESET = BOLD = DIM = ""

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    if status is None:
        print(HEADER)
        print(f"  {DIM}Timestamp: {now}{RESET}")
        print()
        paths = ", ".join(checked_paths or candidate_shm_paths("all"))
        print(f"  No Vortex device detected (checked: {paths})")
        print(f"  Make sure a Vortex application is running with XRT backend.")
        print()
        return

    name = status.device_name.decode("utf-8", errors="replace").rstrip("\x00")
    alive = pid_alive(status.pid)
    pid_str = f"{status.pid}" + (" (running)" if alive else " (dead)")

    # If the owning PID is gone, the state field is stale — show as OFFLINE
    # instead of whatever the dead process last wrote.
    if status.pid and not alive:
        state = 0  # OFFLINE
        state_name = "OFFLINE (stale)"
    else:
        state = status.state
        state_name = STATE_NAMES.get(state, f"UNKNOWN({state})")
    sc = STATE_COLORS.get(state, "") if color else ""

    mem_total = status.mem_used + status.mem_free
    mem_pct = (status.mem_used / mem_total * 100) if mem_total > 0 else 0
    bar_len = 30
    bar_fill = int(bar_len * mem_pct / 100)
    mem_bar = "█" * bar_fill + "░" * (bar_len - bar_fill)

    print(HEADER)
    print(f"  {DIM}Timestamp: {now}{RESET}")
    print()

    # Device info box
    print(f"  {BOLD}Device:{RESET}  {name}")
    print(f"  {BOLD}Cores:{RESET}   {status.num_cores}   "
          f"{BOLD}Warps:{RESET} {status.num_warps}   "
          f"{BOLD}Threads:{RESET} {status.num_threads}   "
          f"{BOLD}Banks:{RESET} {status.num_banks}")
    print(f"  {BOLD}PID:{RESET}     {pid_str}")
    print(f"  {BOLD}State:{RESET}   {sc}{state_name}{RESET}")
    if shm_path:
        print(f"  {BOLD}SHM:{RESET}     {shm_path}")
    print(f"  {BOLD}Uptime:{RESET}  {elapsed_str(status.init_timestamp)}")
    print()

    # Memory
    print(f"  {BOLD}Memory Usage:{RESET}")
    print(f"    [{mem_bar}] {mem_pct:.1f}%")
    print(f"    Used: {human_bytes(status.mem_used)} / "
          f"Total: {human_bytes(mem_total)} / "
          f"Free: {human_bytes(status.mem_free)}")
    print()

    # Transfer stats
    print(f"  {BOLD}Transfer Stats:{RESET}")
    print(f"    Upload:   {human_bytes(status.total_uploaded):>12s}  "
          f"({human_count(status.upload_count)} calls)")
    print(f"    Download: {human_bytes(status.total_downloaded):>12s}  "
          f"({human_count(status.download_count)} calls)")
    print()

    # Board power (peer section with Memory / Transfer / Kernel)
    if power_data is not None:
        print_power_section(power_data, color=color)

    # Kernel stats
    kname = status.last_kernel_name.decode("utf-8", errors="replace").rstrip("\x00")
    # Keep only the last two path components (parent_dir/file) for path-like
    # names so the kernel can be identified without a long workspace prefix.
    if "/" in kname:
        parts = kname.rstrip("/").split("/")
        kname = "/".join(parts[-2:]) if len(parts) >= 2 else parts[-1]
    print(f"  {BOLD}Kernel Stats:{RESET}")
    print(f"    Launches: {status.kernel_launches}")
    if kname:
        print(f"    Last kernel: {kname}")
    if status.last_kernel_addr:
        print(f"    Last kernel addr: 0x{status.last_kernel_addr:x}")
    print(f"    Last activity: {elapsed_str(status.last_activity)} ago")
    print()

    # Bank allocation detail
    active_banks = [(i, status.banks[i]) for i in range(min(status.num_banks, VX_SHM_MAX_BANKS))
                    if status.banks[i].allocated]
    if active_banks:
        print(f"  {BOLD}Active HBM Banks:{RESET}")
        for idx, bank in active_banks:
            print(f"    Bank {idx:2d}: refs={bank.ref_count}, "
                  f"size={human_bytes(bank.bank_size)}")
        print()

    print(f"  {DIM}─────────────────────────────────────────────────────────{RESET}")


def _power_json(power_data):
    """Serialize power_data for JSON output. Returns None if disabled."""
    if power_data is None:
        return None
    if power_data.get("current") is None:
        return {"available": False, "state": power_data.get("state")}
    return {
        "available": True,
        "current_w": power_data["current"],
        "min_w": power_data["min"],
        "max_w": power_data["max"],
        "avg_w": power_data["avg"],
        "samples": power_data["count"],
        "duration_s": power_data["duration_s"],
        "state": power_data["state"],
    }


def print_json(status, shm_path=None, checked_paths=None, power_data=None):
    """Output status as JSON."""
    if status is None:
        payload = {"error": "no device found",
                   "checked_paths": checked_paths or candidate_shm_paths("all")}
        if power_data is not None:
            payload["power"] = _power_json(power_data)
        print(json.dumps(payload, indent=2))
        return

    name = status.device_name.decode("utf-8", errors="replace").rstrip("\x00")
    alive = pid_alive(status.pid)
    state_str = "OFFLINE" if (status.pid and not alive) else STATE_NAMES.get(status.state, "UNKNOWN")
    d = {
        "timestamp": datetime.now().isoformat(),
        "shm_path": shm_path,
        "device_name": name,
        "state": state_str,
        "state_stale": bool(status.pid and not alive and status.state != 0),
        "pid": status.pid,
        "pid_alive": alive,
        "num_cores": status.num_cores,
        "num_warps": status.num_warps,
        "num_threads": status.num_threads,
        "num_banks": status.num_banks,
        "memory": {
            "total": status.mem_used + status.mem_free,
            "used": status.mem_used,
            "free": status.mem_free,
            "utilization_pct": round(status.mem_used / max(1, status.mem_used + status.mem_free) * 100, 1),
        },
        "transfers": {
            "total_uploaded": status.total_uploaded,
            "total_downloaded": status.total_downloaded,
            "upload_count": status.upload_count,
            "download_count": status.download_count,
        },
        "kernel": {
            "launches": status.kernel_launches,
            "last_addr": hex(status.last_kernel_addr),
            "last_name": status.last_kernel_name.decode("utf-8", errors="replace").rstrip("\x00"),
        },
        "timing": {
            "init_timestamp": status.init_timestamp,
            "last_activity": status.last_activity,
            "uptime_sec": int(time.time() - status.init_timestamp / 1000.0) if status.init_timestamp else 0,
        },
        "banks": [
            {"id": i, "ref_count": status.banks[i].ref_count, "bank_size": status.banks[i].bank_size}
            for i in range(min(status.num_banks, VX_SHM_MAX_BANKS))
            if status.banks[i].allocated
        ],
    }
    if power_data is not None:
        d["power"] = _power_json(power_data)
    print(json.dumps(d, indent=2))


def print_status_multi(entries, color=True, checked_paths=None, power_data=None):
    """Print all entries (used for --backend all)."""
    if not entries:
        print_status(None, color=color, checked_paths=checked_paths)
        # Even with no SHM entry, render board power if we have it — power
        # is a board-level metric independent of the runtime SHM.
        if power_data is not None:
            print_power_section(power_data, color=color)
        return

    # Sort by preference for stable display order.
    ranked = sorted(
        entries,
        key=lambda item: (
            1 if item[0].state != 0 else 0,
            1 if pid_alive(item[0].pid) else 0,
            item[0].last_activity,
        ),
        reverse=True,
    )
    # Power belongs to the FPGA, not the SHM entry — attach it to the
    # primary (highest-ranked) entry so it appears once, inline with that
    # entry's Memory / Transfer / Kernel sections.
    for idx, (status, shm_path) in enumerate(ranked, 1):
        print(f"{BOLD}Entry {idx}/{len(ranked)}{RESET}")
        attached_power = power_data if idx == 1 else None
        print_status(status, color=color, shm_path=shm_path,
                     power_data=attached_power)


def print_json_multi(entries, checked_paths=None, power_data=None):
    """Output all entries as JSON (used for --backend all)."""
    if not entries:
        print_json(None, checked_paths=checked_paths, power_data=power_data)
        return

    payload = []
    for status, shm_path in entries:
        name = status.device_name.decode("utf-8", errors="replace").rstrip("\x00")
        alive = pid_alive(status.pid)
        state_str = "OFFLINE" if (status.pid and not alive) else STATE_NAMES.get(status.state, "UNKNOWN")
        payload.append({
            "timestamp": datetime.now().isoformat(),
            "shm_path": shm_path,
            "device_name": name,
            "state": state_str,
            "state_stale": bool(status.pid and not alive and status.state != 0),
            "pid": status.pid,
            "pid_alive": alive,
            "num_cores": status.num_cores,
            "num_warps": status.num_warps,
            "num_threads": status.num_threads,
            "num_banks": status.num_banks,
            "memory": {
                "total": status.mem_used + status.mem_free,
                "used": status.mem_used,
                "free": status.mem_free,
                "utilization_pct": round(status.mem_used / max(1, status.mem_used + status.mem_free) * 100, 1),
            },
            "transfers": {
                "total_uploaded": status.total_uploaded,
                "total_downloaded": status.total_downloaded,
                "upload_count": status.upload_count,
                "download_count": status.download_count,
            },
            "kernel": {
                "launches": status.kernel_launches,
                "last_addr": hex(status.last_kernel_addr),
                "last_name": status.last_kernel_name.decode("utf-8", errors="replace").rstrip("\x00"),
            },
            "timing": {
                "init_timestamp": status.init_timestamp,
                "last_activity": status.last_activity,
                "uptime_sec": int(time.time() - status.init_timestamp / 1000.0) if status.init_timestamp else 0,
            },
            "banks": [
                {"id": i, "ref_count": status.banks[i].ref_count, "bank_size": status.banks[i].bank_size}
                for i in range(min(status.num_banks, VX_SHM_MAX_BANKS))
                if status.banks[i].allocated
            ],
        })

    out = {"devices": payload,
           "checked_paths": checked_paths or candidate_shm_paths("all")}
    if power_data is not None:
        out["power"] = _power_json(power_data)
    print(json.dumps(out, indent=2))


# ─── Main ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="vortex-smi",
        description="Vortex GPGPU System Management Interface",
    )
    parser.add_argument(
        "-l", "--loop", nargs="?", const=1.0, type=float, metavar="SEC",
        help="Loop mode: refresh every SEC seconds (default: 1)",
    )
    parser.add_argument(
        "-j", "--json", action="store_true",
        help="Output in JSON format",
    )
    parser.add_argument(
        "--backend",
        choices=("simx", "hw_emu", "hw", "all"),
        default="all",
        help="Select which backend status to read (default: all)",
    )
    parser.add_argument(
        "--no-color", action="store_true",
        help="Disable ANSI color output",
    )
    parser.add_argument(
        "--xbutil", action="store_true",
        help="Also show xbutil examine summary (requires xbutil in PATH)",
    )
    parser.add_argument(
        "--no-power", action="store_true",
        help="Skip board power sampling. Power is sampled by default for HW "
             "backends (hw/all) and shown as a peer section in the status "
             "display; use this to skip the xrt-smi call for faster refresh.",
    )
    parser.add_argument(
        "--csv", metavar="PATH", default=None,
        help="Append each power sample as 'timestamp_s,power_w,state' "
             "(same format as power_eval.sh). Requires power sampling to be "
             "enabled (default on HW backends; see --no-power).",
    )
    parser.add_argument(
        "--summary", action="store_true",
        help="On exit print P_run_avg / P_run_max and per-state sample counts, "
             "classified by SHM runtime state. Requires power sampling.",
    )

    args = parser.parse_args()

    # Power sampling is on by default for HW-capable backends. Skip on simx /
    # hw_emu (no real board) and when --no-power is given (fast refresh).
    power_enabled = (not args.no_power) and (args.backend in ("hw", "all"))

    # Open CSV up front so a SIGINT mid-run still flushes everything.
    if args.csv:
        if not power_enabled:
            print("vortex-smi: --csv needs power sampling enabled "
                  "(not compatible with --no-power, and only HW backends sample power)",
                  file=sys.stderr); sys.exit(2)
        try:
            new_file = not os.path.exists(args.csv) or os.path.getsize(args.csv) == 0
            fh = open(args.csv, "a", buffering=1)
            if new_file:
                fh.write("timestamp_s,power_w,state\n")
            _power_stats["csv_fh"]   = fh
            _power_stats["csv_path"] = args.csv
        except OSError as e:
            print(f"vortex-smi: cannot open CSV '{args.csv}': {e}", file=sys.stderr); sys.exit(2)
    if args.summary and not power_enabled:
        print("vortex-smi: --summary needs power sampling enabled "
              "(not compatible with --no-power, and only HW backends sample power)",
              file=sys.stderr); sys.exit(2)
    _power_stats["interval_s"] = float(args.loop) if args.loop is not None else 0.0

    def _on_exit(*_):
        if power_enabled and args.summary:
            try: print_power_summary()
            except Exception as e:
                print(f"\n(summary failed: {e})", file=sys.stderr)
        fh = _power_stats.get("csv_fh")
        if fh is not None:
            try: fh.close()
            except Exception: pass
        print()
        sys.exit(0)
    signal.signal(signal.SIGINT, _on_exit)

    def _hw_state_from_status(status):
        try:
            # Stale SHM: owning process gone but state never reset → treat as OFFLINE.
            # Otherwise the IDLE/RUNNING bucket would be polluted with junk samples.
            if getattr(status, "pid", 0) and not pid_alive(status.pid):
                return "OFFLINE"
            return STATE_NAMES.get(status.state, "UNKNOWN")
        except Exception:
            return "UNKNOWN"

    def _hw_state_from_entries(entries):
        for st, path in entries or []:
            if st is not None and "xrt" in (path or "").lower() or "vortex_status" == (path or ""):
                return _hw_state_from_status(st)
        # fallback: any first valid status
        for st, _ in entries or []:
            if st is not None:
                return _hw_state_from_status(st)
        return "UNKNOWN"

    def _one_refresh(loop_mode):
        """One refresh cycle: gather everything (slow ops first), then print.

        The order matters: we sample power BEFORE clearing the screen so the
        ~1s xrt-smi subprocess call doesn't leave the user staring at a
        partially-rendered display. After this function returns, all output
        for the cycle has been emitted in a single contiguous block.
        """
        checked = candidate_shm_paths(args.backend)

        # 1. Read SHM (fast) — needed for power-sample state label.
        if args.backend == "all":
            entries = read_shm_candidates("all")
            hw_state = _hw_state_from_entries(entries)
        else:
            status, shm_path = read_shm(args.backend)
            hw_state = _hw_state_from_status(status) if status is not None else "UNKNOWN"

        # 2. Sample power (slow, ~1s on xrt-smi). Doing this before the clear
        #    keeps the redraw atomic.
        power_data = sample_power_for_state(hw_state) if power_enabled else None

        # 3. Clear and print everything in one shot.
        if loop_mode:
            os.system("clear")
        if args.backend == "all":
            if args.json:
                print_json_multi(entries, checked_paths=checked, power_data=power_data)
            else:
                print_status_multi(entries, color=not args.no_color,
                                   checked_paths=checked, power_data=power_data)
        else:
            if args.json:
                print_json(status, shm_path, checked_paths=checked, power_data=power_data)
            else:
                print_status(status, color=not args.no_color, shm_path=shm_path,
                             checked_paths=checked, power_data=power_data)
        if args.xbutil and args.backend in ("hw", "all"):
            print_xbutil_info()

    if args.loop is not None:
        try:
            while True:
                _one_refresh(loop_mode=True)
                time.sleep(args.loop)
        except KeyboardInterrupt:
            _on_exit()
    else:
        _one_refresh(loop_mode=False)
        if power_enabled and args.summary:
            print_power_summary()
        fh = _power_stats.get("csv_fh")
        if fh is not None:
            try: fh.close()
            except Exception: pass


# Module-level state so loop mode can accumulate session min/avg/max.
# samples: list of (timestamp_s, power_w, state_name) tuples — state_name is the
# SHM runtime state at sampling time (IDLE/RUNNING/UPLOADING/DOWNLOADING/ERROR/OFFLINE/UNKNOWN).
_power_stats = {
    "samples": [],
    "start_t": None,
    "dev_bdf": None,
    "missing_logged": False,
    "csv_fh": None,
    "csv_path": None,
    "interval_s": None,
}


def _detect_dev_bdf():
    """Detect the FPGA device BDF once per process; cache in _power_stats."""
    if _power_stats["dev_bdf"] is not None:
        return _power_stats["dev_bdf"] or None
    import subprocess, tempfile
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as tf:
            tmp = tf.name
        subprocess.run(
            ["/opt/xilinx/xrt/bin/xrt-smi", "--batch", "--force",
             "examine", "-r", "electrical", "-f", "JSON", "-o", tmp],
            capture_output=True, timeout=5,
        )
        with open(tmp) as f:
            d = json.load(f)
        bdf = d["devices"][0].get("device_id", "")
    except Exception:
        bdf = ""
    finally:
        if tmp:
            try: os.unlink(tmp)
            except OSError: pass
    _power_stats["dev_bdf"] = bdf
    return bdf or None


def _sample_power_w():
    """Return current board power in W, or None if unavailable."""
    import subprocess, tempfile
    bdf = _detect_dev_bdf()
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as tf:
            tmp = tf.name
        cmd = ["/opt/xilinx/xrt/bin/xrt-smi", "--batch", "--force", "examine"]
        if bdf:
            cmd += ["-d", bdf]
        cmd += ["-r", "electrical", "-f", "JSON", "-o", tmp]
        r = subprocess.run(cmd, capture_output=True, timeout=5)
        if r.returncode != 0:
            return None
        with open(tmp) as f:
            d = json.load(f)
        el = d["devices"][0].get("electrical", {})
        p = el.get("power_consumption_watts")
        return float(p) if p is not None else None
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError, KeyError, IndexError):
        return None
    finally:
        if tmp:
            try: os.unlink(tmp)
            except OSError: pass


def sample_power_for_state(state_name=None):
    """Sample current board power and record it; return a dict for rendering.

    state_name labels the sample with the runtime state from SHM so that
    print_power_summary() can split idle vs run later (power_eval.sh style).

    Returns:
        None  — power sampling disabled (only the gate in main() should pass
                None to renderers; this helper always returns a dict when called).
        dict  — {"current": float|None, "min", "max", "avg", "count",
                 "duration_s", "state"}; "current" is None if xrt-smi
                 returned no reading.
    """
    label = (state_name or "UNKNOWN").lower()
    p = _sample_power_w()
    if p is None:
        # Sampling attempted but xrt-smi unavailable. Don't record a sample,
        # but still surface the failure mode in the rendered section.
        return {"current": None, "state": label}

    t = time.time()
    _power_stats["samples"].append((t, p, label))
    if _power_stats["start_t"] is None:
        _power_stats["start_t"] = t
    fh = _power_stats["csv_fh"]
    if fh is not None:
        fh.write(f"{t:.6f},{p:.6f},{label}\n")
        fh.flush()

    ps = [s[1] for s in _power_stats["samples"]]
    return {
        "current": p,
        "min": min(ps),
        "max": max(ps),
        "avg": sum(ps) / len(ps),
        "count": len(ps),
        "duration_s": t - _power_stats["start_t"],
        "state": label,
    }


def print_power_section(power_data, color=True):
    """Render the Board Power section. Matches Memory Usage / Transfer Stats style."""
    if power_data is None:
        return
    state = power_data.get("state", "unknown")
    print(f"  {BOLD}Board Power:{RESET}")
    if power_data.get("current") is None:
        print(f"    {DIM}(xrt-smi unavailable or returned no reading){RESET}")
        print()
        return
    print(f"    Current: {power_data['current']:6.2f} W   "
          f"(xrt-smi electrical, state={state})")
    if power_data.get("count", 0) > 1:
        print(f"    Session: avg {power_data['avg']:6.2f} W   "
              f"min {power_data['min']:6.2f} W   "
              f"max {power_data['max']:6.2f} W   "
              f"({power_data['count']} samples, {power_data['duration_s']:.1f}s)")
    print()


def print_power_summary():
    """End-of-run summary, classified by SHM state (idle / RUNNING / transfer / other)."""
    samples = _power_stats["samples"]
    if not samples:
        print(f"\n{DIM}(no power samples collected){RESET}")
        return

    idle, run, xfer, other = [], [], [], []
    for _, p, st in samples:
        if st in ("idle", "offline"):
            idle.append(p)
        elif st == "running":
            run.append(p)
        elif st in ("uploading", "downloading"):
            xfer.append(p)
        else:
            other.append(p)

    interval = _power_stats["interval_s"] or 0.0
    t_idle = len(idle) * interval
    t_run  = len(run)  * interval
    t_xfer = len(xfer) * interval

    print()
    print(f"  {BOLD}Power Summary{RESET}  (state-classified)")
    print(f"    interval={interval:.3f}s   total_samples={len(samples)}")
    print(f"    by state: idle={len(idle)}  run={len(run)}  transfer={len(xfer)}  other={len(other)}")
    P_idle_avg = sum(idle) / len(idle) if idle else float("nan")
    P_idle_max = max(idle) if idle else float("nan")
    P_run_avg  = sum(run) / len(run) if run else float("nan")
    P_run_max  = max(run) if run else float("nan")

    if idle:
        print(f"    P_idle_avg = {P_idle_avg:6.3f} W   P_idle_max = {P_idle_max:6.3f} W   t_idle = {t_idle:.2f}s")
    else:
        print(f"    P_idle_*   =   (no IDLE/OFFLINE samples)")
    if run:
        print(f"    P_run_avg  = {P_run_avg:6.3f} W   P_run_max  = {P_run_max:6.3f} W   t_run  = {t_run:.2f}s")
        if xfer:
            print(f"    t_transfer = {t_xfer:.2f}s")
        if idle:
            dP_avg  = P_run_avg - P_idle_avg
            dP_peak = P_run_max - P_idle_avg
            print(f"    ΔP_avg     = {dP_avg:+.3f} W   ΔP_peak    = {dP_peak:+.3f} W   (vs P_idle_avg)")
    else:
        print(f"    P_run_*    =   (no RUNNING samples — sampling interval may be too coarse)")
    if _power_stats["csv_path"]:
        print(f"    CSV        = {_power_stats['csv_path']}")
    print()


def print_xbutil_info():
    """Optionally print xbutil examine summary."""
    import subprocess
    try:
        result = subprocess.run(
            ["xbutil", "examine", "-d", "0000:3d:00.1", "--report", "platform"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0:
            print(f"  {BOLD}xbutil Platform Info:{RESET}")
            for line in result.stdout.strip().split("\n"):
                print(f"    {line}")
            print()
    except FileNotFoundError:
        print(f"  {DIM}(xbutil not found in PATH){RESET}")
    except subprocess.TimeoutExpired:
        print(f"  {DIM}(xbutil timed out){RESET}")
    except Exception as e:
        print(f"  {DIM}(xbutil error: {e}){RESET}")


