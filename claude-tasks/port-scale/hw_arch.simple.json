          "name": "u_tensor memory bank",
          "module": "tensor memory bank",
          "array": [
            8
          ]
        },
        {
          "name": "input_ldma",
          "module": "local DMA"
        },
        {
          "name": "weight_ldma",
          "module": "local DMA"
        },
        {
          "name": "scale_zp_ldma",
          "module": "local DMA"
        },
