        },
        {
          "name": "u_sz_mux",
          "module": "8:1 switch"
        },
        {
          "name": "u_weight_mux",
          "module": "8:1 switch"
        },
        {
          "name": "u_gemm_unit",
          "module": "gemm_unit"
        },
        {
          "name": "u_out_demux",
          "module": "1:8 switch"
        }
      ],
