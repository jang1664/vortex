        },
        {
          "from": [
            "u_tensor memory bank.mem_bus_slave"
          ],
          "to": [
            "u_weight_mux.in"
          ],
          "from_shape": [
            8
          ],
          "to_shape": [
            8
          ],
          "description": "TMEM bank[8]의 read port에서 weight mux의 in[8]으로 1:1 연결"
        },
        {
          "from": [
            "u_tensor memory bank.mem_bus_slave"
          ],
          "to": [
            "u_sz_mux.in"
          ],
          "from_shape": [
            8
          ],
          "to_shape": [
            8
          ],
          "description": "TMEM bank[8]의 read port에서 scale/zero mux의 in[8]으로 1:1 연결"
        },
        {
          "from": [
            "u_in_mux.out"
          ],
          "to": [
