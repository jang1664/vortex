+# Resolve names to typed objects and read one property in bulk. A collection
+# of pblocks cannot detect an unassigned leaf, so preserve every cell's value.
+proc ::vortex::mxu_slr::placement_properties {property} {
+    variable cells
+    set objects [get_cells -quiet [dict keys $cells]]
+    set names [get_property NAME $objects]
+    set values [get_property $property $objects]
+    if {[llength $objects] == 1} {set values [list $values]}
+    if {[llength $objects] != [dict size $cells]
+        || [llength $names] != [dict size $cells]
+        || [llength $values] != [dict size $cells]} {
+        error "Incomplete MXU $property inventory"
+    }
+    array set expected $cells
+    array set actual {}
+    foreach name $names value $values {
+        if {![info exists expected($name)] || [info exists actual($name)]} {
+            error "Unexpected or duplicate MXU cell: $name"
+        }
+        set actual($name) $value
+    }
+    return [array get actual]
+}
