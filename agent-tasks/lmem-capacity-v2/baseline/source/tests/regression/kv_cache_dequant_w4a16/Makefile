ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := kv_cache_dequant_w4a16

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp

KV_CACHE_DEQUANT_FP16_PROFILE := $(and $(findstring -DEXT_D_DISABLE,$(CONFIGS)),$(findstring -DEXT_ZFH_ENABLE,$(CONFIGS)))
ifneq (,$(KV_CACHE_DEQUANT_FP16_PROFILE))
  KV_CACHE_DEQUANT_PROFILE_VARIANT := groupwise_fp16
else
  KV_CACHE_DEQUANT_PROFILE_VARIANT := groupwise_fp32
endif

KV_CACHE_DEQUANT_VARIANT ?= $(KV_CACHE_DEQUANT_PROFILE_VARIANT)
KV_CACHE_DEQUANT_VARIANTS := baseline packed_pair groupwise groupwise_fp16 groupwise_fp32
ifneq ($(filter $(KV_CACHE_DEQUANT_VARIANT),$(KV_CACHE_DEQUANT_VARIANTS)),$(KV_CACHE_DEQUANT_VARIANT))
  $(error Unsupported KV_CACHE_DEQUANT_VARIANT=$(KV_CACHE_DEQUANT_VARIANT); expected one of: $(KV_CACHE_DEQUANT_VARIANTS))
endif

KV_CACHE_DEQUANT_SELECTED_VARIANT := $(if $(filter groupwise,$(KV_CACHE_DEQUANT_VARIANT)),$(KV_CACHE_DEQUANT_PROFILE_VARIANT),$(KV_CACHE_DEQUANT_VARIANT))

VX_SRCS := $(SRC_DIR)/kernel.$(KV_CACHE_DEQUANT_SELECTED_VARIANT).cpp

ifneq (,$(filter groupwise_fp16 groupwise_fp32,$(KV_CACHE_DEQUANT_SELECTED_VARIANT)))
  CXXFLAGS += -DKV_CACHE_DEQUANT_VARIANT=KV_CACHE_DEQUANT_VARIANT_GROUPWISE
  ifeq ($(KV_CACHE_DEQUANT_SELECTED_VARIANT),groupwise_fp16)
    CXXFLAGS += -DKV_CACHE_DEQUANT_ARITH_FP16=1
  else
    CXXFLAGS += -DKV_CACHE_DEQUANT_ARITH_FP32=1
  endif
else ifeq ($(KV_CACHE_DEQUANT_VARIANT),packed_pair)
  CXXFLAGS += -DKV_CACHE_DEQUANT_VARIANT=KV_CACHE_DEQUANT_VARIANT_PACKED_PAIR
else
  CXXFLAGS += -DKV_CACHE_DEQUANT_VARIANT=KV_CACHE_DEQUANT_VARIANT_BASELINE
endif

include ../common.mk
