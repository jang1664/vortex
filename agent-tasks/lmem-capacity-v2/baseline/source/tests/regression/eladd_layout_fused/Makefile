ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := eladd_layout_fused

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp

ELADD_LAYOUT_FUSED_VARIANT ?= adaptive_chunk32
ELADD_LAYOUT_FUSED_VARIANTS := baseline tile_chunk32 warp_coalesced_chunk32 adaptive_chunk32
ifneq ($(filter $(ELADD_LAYOUT_FUSED_VARIANT),$(ELADD_LAYOUT_FUSED_VARIANTS)),$(ELADD_LAYOUT_FUSED_VARIANT))
  $(error Unsupported ELADD_LAYOUT_FUSED_VARIANT=$(ELADD_LAYOUT_FUSED_VARIANT); expected one of: $(ELADD_LAYOUT_FUSED_VARIANTS))
endif

VX_SRCS := $(SRC_DIR)/kernel.$(ELADD_LAYOUT_FUSED_VARIANT).cpp
ifeq ($(ELADD_LAYOUT_FUSED_VARIANT),adaptive_chunk32)
  CXXFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=3
  VX_CFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=3
else ifeq ($(ELADD_LAYOUT_FUSED_VARIANT),warp_coalesced_chunk32)
  CXXFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=2
  VX_CFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=2
else ifeq ($(ELADD_LAYOUT_FUSED_VARIANT),tile_chunk32)
  CXXFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=1
  VX_CFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=1
else
  CXXFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=0
  VX_CFLAGS += -DELADD_LAYOUT_FUSED_VARIANT_TAG=0
endif

include ../common.mk
