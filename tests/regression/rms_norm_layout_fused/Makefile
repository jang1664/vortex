ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := rms_norm_layout_fused

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp

RMS_NORM_LAYOUT_FUSED_VARIANT ?= shuffle_warp
RMS_NORM_LAYOUT_FUSED_VARIANTS := baseline shuffle_warp
ifneq ($(filter $(RMS_NORM_LAYOUT_FUSED_VARIANT),$(RMS_NORM_LAYOUT_FUSED_VARIANTS)),$(RMS_NORM_LAYOUT_FUSED_VARIANT))
  $(error Unsupported RMS_NORM_LAYOUT_FUSED_VARIANT=$(RMS_NORM_LAYOUT_FUSED_VARIANT); expected one of: $(RMS_NORM_LAYOUT_FUSED_VARIANTS))
endif

VX_SRCS := $(SRC_DIR)/kernel.$(RMS_NORM_LAYOUT_FUSED_VARIANT).cpp
ifeq ($(RMS_NORM_LAYOUT_FUSED_VARIANT),shuffle_warp)
  CXXFLAGS += -DRMS_NORM_LAYOUT_FUSED_VARIANT_TAG=1
  VX_CFLAGS += -DRMS_NORM_LAYOUT_FUSED_VARIANT_TAG=1
else
  CXXFLAGS += -DRMS_NORM_LAYOUT_FUSED_VARIANT_TAG=0
  VX_CFLAGS += -DRMS_NORM_LAYOUT_FUSED_VARIANT_TAG=0
endif

include ../common.mk
