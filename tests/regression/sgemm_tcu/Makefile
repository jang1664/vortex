ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := sgemm_tcu

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp $(SW_COMMON_DIR)/rvfloats.cpp $(SW_COMMON_DIR)/softfloat_ext.cpp

SGEMM_TCU_VARIANT ?= b_colmajor
SGEMM_TCU_VARIANTS := baseline b_colmajor lmem lmem_b_colmajor \
                      kstage4 kstage4_n2 kstage4_m2n2 kstage4_m2n2_wide64 \
                      kstage4_wide64
ifneq ($(filter $(SGEMM_TCU_VARIANT),$(SGEMM_TCU_VARIANTS)),$(SGEMM_TCU_VARIANT))
  $(error Unsupported SGEMM_TCU_VARIANT=$(SGEMM_TCU_VARIANT); expected one of: $(SGEMM_TCU_VARIANTS))
endif

VX_KERNEL ?= kernel.$(SGEMM_TCU_VARIANT).cpp
VX_SRCS := $(SRC_DIR)/$(VX_KERNEL)

SGEMM_TCU_DEFAULT_FRAGS_M := 1
SGEMM_TCU_DEFAULT_FRAGS_N := 1
SGEMM_TCU_DEFAULT_K_STAGE_TILES := 1
SGEMM_TCU_DEFAULT_LOAD_BYTES := 4

ifeq ($(SGEMM_TCU_VARIANT),b_colmajor)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_B_COLMAJOR
else ifeq ($(SGEMM_TCU_VARIANT),lmem)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_LMEM
else ifeq ($(SGEMM_TCU_VARIANT),lmem_b_colmajor)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_LMEM_B_COLMAJOR
else ifeq ($(SGEMM_TCU_VARIANT),kstage4)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_KSTAGE4
  SGEMM_TCU_DEFAULT_K_STAGE_TILES := 4
else ifeq ($(SGEMM_TCU_VARIANT),kstage4_n2)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_KSTAGE4_N2
  SGEMM_TCU_DEFAULT_FRAGS_N := 2
  SGEMM_TCU_DEFAULT_K_STAGE_TILES := 4
else ifeq ($(SGEMM_TCU_VARIANT),kstage4_m2n2)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_KSTAGE4_M2N2
  SGEMM_TCU_DEFAULT_FRAGS_M := 2
  SGEMM_TCU_DEFAULT_FRAGS_N := 2
  SGEMM_TCU_DEFAULT_K_STAGE_TILES := 4
else ifeq ($(SGEMM_TCU_VARIANT),kstage4_m2n2_wide64)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_KSTAGE4_M2N2_WIDE64
  SGEMM_TCU_DEFAULT_FRAGS_M := 2
  SGEMM_TCU_DEFAULT_FRAGS_N := 2
  SGEMM_TCU_DEFAULT_K_STAGE_TILES := 4
  SGEMM_TCU_DEFAULT_LOAD_BYTES := 8
else ifeq ($(SGEMM_TCU_VARIANT),kstage4_wide64)
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_KSTAGE4_WIDE64
  SGEMM_TCU_DEFAULT_K_STAGE_TILES := 4
  SGEMM_TCU_DEFAULT_LOAD_BYTES := 8
else
  SGEMM_TCU_VARIANT_ID := SGEMM_TCU_VARIANT_BASELINE
endif

SGEMM_TCU_WARPS_M ?= 2
SGEMM_TCU_WARPS_N ?= 2
SGEMM_TCU_FRAGS_M ?= $(SGEMM_TCU_DEFAULT_FRAGS_M)
SGEMM_TCU_FRAGS_N ?= $(SGEMM_TCU_DEFAULT_FRAGS_N)
SGEMM_TCU_K_STAGE_TILES ?= $(SGEMM_TCU_DEFAULT_K_STAGE_TILES)
SGEMM_TCU_LOAD_BYTES ?= $(SGEMM_TCU_DEFAULT_LOAD_BYTES)

CXXFLAGS += -DSGEMM_TCU_VARIANT=$(SGEMM_TCU_VARIANT_ID)
CXXFLAGS += -DSGEMM_TCU_WARPS_M=$(SGEMM_TCU_WARPS_M)
CXXFLAGS += -DSGEMM_TCU_WARPS_N=$(SGEMM_TCU_WARPS_N)
CXXFLAGS += -DSGEMM_TCU_FRAGS_M=$(SGEMM_TCU_FRAGS_M)
CXXFLAGS += -DSGEMM_TCU_FRAGS_N=$(SGEMM_TCU_FRAGS_N)
CXXFLAGS += -DSGEMM_TCU_K_STAGE_TILES=$(SGEMM_TCU_K_STAGE_TILES)
CXXFLAGS += -DSGEMM_TCU_LOAD_BYTES=$(SGEMM_TCU_LOAD_BYTES)
VX_CFLAGS += -DSGEMM_TCU_VARIANT=$(SGEMM_TCU_VARIANT_ID)
VX_CFLAGS += -DSGEMM_TCU_WARPS_M=$(SGEMM_TCU_WARPS_M)
VX_CFLAGS += -DSGEMM_TCU_WARPS_N=$(SGEMM_TCU_WARPS_N)
VX_CFLAGS += -DSGEMM_TCU_FRAGS_M=$(SGEMM_TCU_FRAGS_M)
VX_CFLAGS += -DSGEMM_TCU_FRAGS_N=$(SGEMM_TCU_FRAGS_N)
VX_CFLAGS += -DSGEMM_TCU_K_STAGE_TILES=$(SGEMM_TCU_K_STAGE_TILES)
VX_CFLAGS += -DSGEMM_TCU_LOAD_BYTES=$(SGEMM_TCU_LOAD_BYTES)

CXXFLAGS += -I$(THIRD_PARTY_DIR)/softfloat/source/include

LDFLAGS += $(THIRD_PARTY_DIR)/softfloat/build/Linux-x86_64-GCC/softfloat.a

include ../common.mk
