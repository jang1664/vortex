ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := rope_layout_fused

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp

ROPE_LAYOUT_FUSED_VARIANT ?= task_chunk16
ROPE_LAYOUT_FUSED_VARIANTS := baseline task_chunk16 subwarp_chunk16
ifneq ($(filter $(ROPE_LAYOUT_FUSED_VARIANT),$(ROPE_LAYOUT_FUSED_VARIANTS)),$(ROPE_LAYOUT_FUSED_VARIANT))
  $(error Unsupported ROPE_LAYOUT_FUSED_VARIANT=$(ROPE_LAYOUT_FUSED_VARIANT); expected one of: $(ROPE_LAYOUT_FUSED_VARIANTS))
endif

VX_SRCS := $(SRC_DIR)/kernel.$(ROPE_LAYOUT_FUSED_VARIANT).cpp

ifeq ($(ROPE_LAYOUT_FUSED_VARIANT),subwarp_chunk16)
  CXXFLAGS += -DROPE_LAYOUT_FUSED_VARIANT_TAG=2
  VX_CFLAGS += -DROPE_LAYOUT_FUSED_VARIANT_TAG=2
else ifeq ($(ROPE_LAYOUT_FUSED_VARIANT),task_chunk16)
  CXXFLAGS += -DROPE_LAYOUT_FUSED_VARIANT_TAG=1
  VX_CFLAGS += -DROPE_LAYOUT_FUSED_VARIANT_TAG=1
else
  CXXFLAGS += -DROPE_LAYOUT_FUSED_VARIANT_TAG=0
  VX_CFLAGS += -DROPE_LAYOUT_FUSED_VARIANT_TAG=0
endif

include ../common.mk
