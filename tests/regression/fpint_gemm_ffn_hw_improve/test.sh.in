#!/bin/bash

set -euo pipefail

# Allow override from environment
export CONFIGS="${CONFIGS:--DNUM_CORES=1 -DMEM_ADDR_WIDTH=34 -DPLATFORM_MEMORY_ADDR_WIDTH=34}"
export MAX_LOG_BYTES="${MAX_LOG_BYTES:-10485760}"  # 10 MB
DRIVER="${DRIVER:-rtlsim}"
APP="${APP:-fpint_gemm_ffn_hw_improve}"
DEBUG_LEVEL="${DEBUG_LEVEL:-0}"
DEBUG_ARG_MODE="always"
LOG_DIR="${LOG_DIR:-run_logs_fpint_gemm_ffn_hw_improve}"

mkdir -p "${LOG_DIR}"
rm -rf "${LOG_DIR:?}"/*

# Constraints:
#   N must be a multiple of MXU_NT (32)
#   K must be a multiple of MXU_KT (32)
#   M must be a multiple of 32

# If command-line arguments are provided, use them as test cases directly.
# Example: bash test.sh --debug-arg=omit -m 2 -n 32 -k 128 -q 32 -t 0 -d 0
# Example: bash test.sh --debug-omit -m 2 -n 32 -k 128 -q 32 -t 0 -d 0
# Example: bash test.sh --debug-arg=omit "-m 2 -n 32 -k 128 -q 32 -t 0 -d 0"
declare -a RAW_CASE_ARGS=()
for arg in "$@"; do
  case "${arg}" in
    --debug-arg=always|--debug-arg=omit|--debug-arg=auto)
      DEBUG_ARG_MODE="${arg#*=}"
      ;;
    --debug-always)
      DEBUG_ARG_MODE="always"
      ;;
    --debug-omit)
      DEBUG_ARG_MODE="omit"
      ;;
    --debug-auto)
      DEBUG_ARG_MODE="auto"
      ;;
    --debug-arg=*)
      echo "ERROR: invalid debug arg mode: ${arg#*=} (expected always, omit, or auto)" >&2
      exit 1
      ;;
    --)
      ;;
    *)
      RAW_CASE_ARGS+=("${arg}")
      ;;
  esac
done

declare -a DEBUG_ARGS=()
case "${DEBUG_ARG_MODE}" in
  always)
    DEBUG_ARGS=(--debug="${DEBUG_LEVEL}")
    ;;
  omit)
    ;;
  auto)
    if [[ ${DEBUG_LEVEL} -ge 1 ]]; then
      DEBUG_ARGS=(--debug="${DEBUG_LEVEL}")
    fi
    ;;
esac

if [[ ${#RAW_CASE_ARGS[@]} -gt 0 ]]; then
  declare -a CASE_ARGS=()
  split_tokens=0
  for arg in "${RAW_CASE_ARGS[@]}"; do
    if [[ "${arg}" == *" "* ]]; then
      CASE_ARGS+=("${arg}")
    else
      split_tokens=1
    fi
  done
  if [[ ${#CASE_ARGS[@]} -eq 0 || ${split_tokens} -eq 1 ]]; then
    CASE_ARGS=("${RAW_CASE_ARGS[*]}")
  fi
else
  # Default sweep: shape x qblk x wtrans x qdir
  declare -a SHAPES=(
    # K=32 (minimum K-tile)
    "-m 32 -n 32 -k 32"
    "-m 128 -n 32 -k 32"
    "-m 128 -n 128 -k 64"
    "-m 128 -n 128 -k 96"
    # baseline (small)
    "-m 128 -n 128 -k 128"
    "-m 256 -n 128 -k 128"
    "-m 256 -n 256 -k 256"
  )
  declare -a QBLKS=(32)
  declare -a WTRANS_LIST=(0 1)
  declare -a QDIR_LIST=(0 1)

  declare -a CASE_ARGS=()
  for shape in "${SHAPES[@]}"; do
    for qblk in "${QBLKS[@]}"; do
      for wtrans in "${WTRANS_LIST[@]}"; do
        for qdir in "${QDIR_LIST[@]}"; do
          CASE_ARGS+=("${shape} -q ${qblk} -t ${wtrans} -d ${qdir}")
        done
      done
    done
  done
fi

total="${#CASE_ARGS[@]}"
failed=0

for i in "${!CASE_ARGS[@]}"; do
  idx=$((i + 1))
  args="${CASE_ARGS[$i]}"
  log_file="${LOG_DIR}/run_case_${idx}.log"

  echo "[${idx}/${total}] Running: ${args}" | tee -a "${log_file}"
  if ./ci/blackbox.sh \
      --driver="${DRIVER}" \
      --app="${APP}" \
      "${DEBUG_ARGS[@]}" \
      --log="${log_file}" \
      --args="${args}"; then
    echo "[${idx}/${total}] PASS (log: ${log_file})" | tee -a "${log_file}"
  else
    echo "[${idx}/${total}] FAIL (log: ${log_file})" | tee -a "${log_file}"
    failed=$((failed + 1))
  fi
done

echo "Summary: total=${total}, failed=${failed}, passed=$((total - failed))" | tee -a "${LOG_DIR}/summary.log"
exit "${failed}"
