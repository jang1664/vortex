#!/bin/bash

set -euo pipefail

# Allow override from environment
#export CONFIGS="${CONFIGS:--DDBG_TRACE_GEMM_FSM -DNUM_CORES=2 -DLMEM_LOG_SIZE=17 -DLMEM_BASE_ADDR=8589803520}"
export CONFIGS="${CONFIGS:--DDBG_TRACE_GEMM_FSM -DNUM_CORES=1 -DMEM_ADDR_WIDTH=34 -DPLATFORM_MEMORY_ADDR_WIDTH=34}"
export MAX_LOG_BYTES="${MAX_LOG_BYTES:-10485760}"  # 10 MB
DRIVER="${DRIVER:-rtlsim}"
APP="${APP:-fpint_gemm_ffn_hw}"
DEBUG_LEVEL="${DEBUG_LEVEL:-3}"
LOG_DIR="${LOG_DIR:-run_logs_fpint_gemm_ffn_hw}"

mkdir -p "${LOG_DIR}"

# Add/remove cases here
#declare -a CASE_ARGS=(
#  "-m 2 -n 32 -k 32 -q 32"
#  "-m 4 -n 64 -k 64 -q 32"
#  "-m 8 -n 64 -k 128 -q 32"
#)

#declare -a CASE_ARGS=(
#  "-m 2 -n 256 -k 32 -q 32"
#  "-m 128 -n 256 -k 32 -q 32"
#  "-m 256 -n 256 -k 32 -q 32"
#)

#declare -a CASE_ARGS=(
#  "-m 2 -n 256 -k 256 -q 32"
#  "-m 128 -n 256 -k 256 -q 32"
#  "-m 256 -n 256 -k 256 -q 32"
#)

# If command-line arguments are provided, use them as test cases directly.
# Example: bash test.sh "-m 2 -n 32 -k 32 -q 32 -t 1 -d 0" "-m 4 -n 64 -k 64 -q 32 -t 0 -d 1"
if [[ $# -gt 0 ]]; then
  declare -a CASE_ARGS=("$@")
else
  # Default sweep: shape x qblk x wtrans x qdir
  declare -a SHAPES=(
    # baseline
    "-m 32 -n 32 -k 32"
    "-m 32 -n 128 -k 64"
    "-m 128 -n 32 -k 64"
    "-m 128 -n 128 -k 128"

    # 32 경계 (odd 포함)
    "-m 31 -n 32 -k 64"
    "-m 33 -n 32 -k 64"
    "-m 32 -n 31 -k 64"
    "-m 32 -n 33 -k 64"
    "-m 31 -n 31 -k 64"
    "-m 33 -n 33 -k 64"

    # 128 경계 (odd 포함)
    "-m 127 -n 128 -k 128"
    "-m 129 -n 128 -k 128"
    "-m 128 -n 127 -k 128"
    "-m 128 -n 129 -k 128"
    "-m 127 -n 127 -k 128"
    "-m 129 -n 129 -k 128"

    # 비대칭/비-2^p m,n
    "-m 95 -n 160 -k 256"
    "-m 160 -n 95 -k 256"
    "-m 257 -n 191 -k 256"

    # 큰 수
    "-m 384 -n 384 -k 128"
    "-m 384 -n 384 -k 384"
    "-m 511 -n 511 -k 512"
    "-m 512 -n 512 -k 512"
    "-m 513 -n 513 -k 512"
  )
  declare -a QBLKS=(32)
  declare -a WTRANS_LIST=(0 1)
  declare -a QDIR_LIST=(0 1)

  declare -a CASE_ARGS=()
  for shape in "${SHAPES[@]}"; do
    for qblk in "${QBLKS[@]}"; do
      for wtrans in "${WTRANS_LIST[@]}"; do
        for qdir in "${QDIR_LIST[@]}"; do
          CASE_ARGS+=("${shape} -q ${qblk} -t ${wtrans} -d ${qdir}")
        done
      done
    done
  done
fi

total="${#CASE_ARGS[@]}"
failed=0

for i in "${!CASE_ARGS[@]}"; do
  idx=$((i + 1))
  args="${CASE_ARGS[$i]}"
  log_file="${LOG_DIR}/run_case_${idx}.log"

  echo "[${idx}/${total}] Running: ${args}"
  if [[ ${DEBUG_LEVEL} -ge 1 ]]; then
    if ./ci/blackbox.sh \
        --driver="${DRIVER}" \
        --app="${APP}" \
        --debug="${DEBUG_LEVEL}" \
        --log="${log_file}" \
        --args="${args}"; then
      echo "[${idx}/${total}] PASS (log: ${log_file})"
    else
      echo "[${idx}/${total}] FAIL (log: ${log_file})"
      failed=$((failed + 1))
    fi
  else
    if ./ci/blackbox.sh \
        --driver="${DRIVER}" \
        --app="${APP}" \
        --log="${log_file}" \
        --args="${args}"; then
      echo "[${idx}/${total}] PASS (log: ${log_file})"
    else
      echo "[${idx}/${total}] FAIL (log: ${log_file})"
      failed=$((failed + 1))
    fi
  fi
done

echo "Summary: total=${total}, failed=${failed}, passed=$((total - failed))"
exit "${failed}"