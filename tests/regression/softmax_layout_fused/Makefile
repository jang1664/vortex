ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := softmax_layout_fused

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp

SOFTMAX_LAYOUT_FUSED_VARIANT ?= rev2_shuffle_grouped
SOFTMAX_LAYOUT_FUSED_VARIANTS := rev1 rev2 rev2_chunked rev2_addrgen rev2_shuffle rev2_shuffle_unroll2 rev2_shuffle_addr32 rev2_shuffle_grouped opt opt_warp
ifneq ($(filter $(SOFTMAX_LAYOUT_FUSED_VARIANT),$(SOFTMAX_LAYOUT_FUSED_VARIANTS)),$(SOFTMAX_LAYOUT_FUSED_VARIANT))
  $(error Unsupported SOFTMAX_LAYOUT_FUSED_VARIANT=$(SOFTMAX_LAYOUT_FUSED_VARIANT); expected one of: $(SOFTMAX_LAYOUT_FUSED_VARIANTS))
endif

ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),opt_warp)
  VX_SRCS := $(SRC_DIR)/kernel.opt_warp.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_OPT_WARP
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_OPT
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2_addrgen)
  VX_SRCS := $(SRC_DIR)/kernel.rev2_addrgen.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_ADDRGEN
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_ADDRGEN
  VX_CFLAGS += -DEXT_ADDR_GEN_ENABLE
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2_chunked)
  VX_SRCS := $(SRC_DIR)/kernel.rev2_chunked.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_CHUNKED
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_CHUNKED
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2_shuffle)
  VX_SRCS := $(SRC_DIR)/kernel.rev2_shuffle.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2_shuffle_unroll2)
  VX_SRCS := $(SRC_DIR)/kernel.rev2_shuffle_unroll2.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE_UNROLL2
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE_UNROLL2
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2_shuffle_addr32)
  VX_SRCS := $(SRC_DIR)/kernel.rev2_shuffle_addr32.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE_ADDR32
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE_ADDR32
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2_shuffle_grouped)
  VX_SRCS := $(SRC_DIR)/kernel.rev2_shuffle_grouped.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE_GROUPED
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2_SHUFFLE_GROUPED
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),rev2)
  VX_SRCS := $(SRC_DIR)/kernel.rev2.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV2
else ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),opt)
  VX_SRCS := $(SRC_DIR)/kernel.opt.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_OPT
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_OPT
else
  VX_SRCS := $(SRC_DIR)/kernel.rev1.cpp
  CXXFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT=SOFTMAX_LAYOUT_FUSED_VARIANT_REV1
  VX_CFLAGS += -DSOFTMAX_LAYOUT_FUSED_VARIANT_KERNEL=SOFTMAX_LAYOUT_FUSED_VARIANT_REV1
endif

ifeq ($(SOFTMAX_LAYOUT_FUSED_VARIANT),opt_warp)
# opt_warp includes kernel.opt.cpp.
kernel.elf: $(SRC_DIR)/kernel.opt.cpp
else ifneq ($(filter rev2_shuffle_unroll2 rev2_shuffle_addr32 rev2_shuffle_grouped,$(SOFTMAX_LAYOUT_FUSED_VARIANT)),)
kernel.elf: $(SRC_DIR)/kernel.rev2_shuffle.cpp
else ifneq ($(filter rev2 rev2_chunked rev2_addrgen rev2_shuffle rev2_shuffle_unroll2 rev2_shuffle_addr32 rev2_shuffle_grouped,$(SOFTMAX_LAYOUT_FUSED_VARIANT)),)
kernel.elf: $(VORTEX_HOME)/tests/regression/softmax_common/kernel.simt_cached.h
endif

include ../common.mk
