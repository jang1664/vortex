ROOT_DIR := $(realpath ../../..)
include $(ROOT_DIR)/config.mk

PROJECT := head_concat_layout_fused

SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)

SRCS := $(SRC_DIR)/main.cpp

HEAD_CONCAT_LAYOUT_FUSED_VARIANT ?= chunk16_packed
HEAD_CONCAT_LAYOUT_FUSED_VARIANTS := baseline chunk16_packed subwarp_chunk16
ifneq ($(filter $(HEAD_CONCAT_LAYOUT_FUSED_VARIANT),$(HEAD_CONCAT_LAYOUT_FUSED_VARIANTS)),$(HEAD_CONCAT_LAYOUT_FUSED_VARIANT))
  $(error Unsupported HEAD_CONCAT_LAYOUT_FUSED_VARIANT=$(HEAD_CONCAT_LAYOUT_FUSED_VARIANT); expected one of: $(HEAD_CONCAT_LAYOUT_FUSED_VARIANTS))
endif

VX_SRCS := $(SRC_DIR)/kernel.$(HEAD_CONCAT_LAYOUT_FUSED_VARIANT).cpp
ifeq ($(HEAD_CONCAT_LAYOUT_FUSED_VARIANT),subwarp_chunk16)
  CXXFLAGS += -DHEAD_CONCAT_LAYOUT_FUSED_VARIANT_TAG=2
  VX_CFLAGS += -DHEAD_CONCAT_LAYOUT_FUSED_VARIANT_TAG=2
else ifeq ($(HEAD_CONCAT_LAYOUT_FUSED_VARIANT),chunk16_packed)
  CXXFLAGS += -DHEAD_CONCAT_LAYOUT_FUSED_VARIANT_TAG=1
  VX_CFLAGS += -DHEAD_CONCAT_LAYOUT_FUSED_VARIANT_TAG=1
else
  CXXFLAGS += -DHEAD_CONCAT_LAYOUT_FUSED_VARIANT_TAG=0
  VX_CFLAGS += -DHEAD_CONCAT_LAYOUT_FUSED_VARIANT_TAG=0
endif

include ../common.mk
