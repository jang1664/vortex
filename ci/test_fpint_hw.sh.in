#!/bin/bash
set -euo pipefail

mode=$1
shift

if [[ "${mode}" == "" ]]; then
  echo "Usage: $0 <mode>"
  echo "Modes:"
  echo "  rtlsim   - Run only rtlsim tests"
  echo "  xrtsim   - Run only xrtsim tests"
  echo "  xrt-vcs-sim   - Run only xrt-vcs-sim tests"
  echo "  xrt-vcs-pgsim   - Run only xrt-vcs-pgsim tests"
  echo "  hw_emu    - Run only hw_emu tests"
  echo "  hw        - Run only hw tests"
  exit 1
fi

CONFIGS=""
CONFIGS+=" -DMEM_ADDR_WIDTH=34 -DPLATFORM_MEMORY_ADDR_WIDTH=34 -DPLATFORM_MEMORY_NUM_BANKS=32 -DPLATFORM_MERGED_MEMORY_INTERFACE"
# CONFIGS+=" -DFPU_FPNEW"
CONFIGS+=" -DDCACHE_DISABLE -DL2_ENABLE -DNUM_THREADS=8"
# CONFIGS+=" -DLMEM_LOG_SIZE=22 -DSTACK_BASE_ADDR=8585740288"
CONFIGS+=" -DAFU_DONE_WAIT_CACHE_DRAIN"
CONFIGS+=" -DNUM_CORES=1"

# ------------------------------------------------------------------------
# - Add DBG flag if you want
# ------------------------------------------------------------------------
# CONFIGS+=" -DDBG_TRACE_PIPELINE"
# CONFIGS+=" -DDBG_TRACE_MEM"
# CONFIGS+=" -DDBG_TRACE_CACHE"
# CONFIGS+=" -DDBG_TRACE_AFU"
# CONFIGS+=" -DDBG_TRACE_SCOPE"
# CONFIGS+=" -DDBG_TRACE_GBAR"
# CONFIGS+=" -DDBG_TRACE_TCU"
# CONFIGS+=" -DDBG_TRACE_GEMM"
CONFIGS+=" -DDBG_TRACE_GEMM_FSM"
CONFIGS+=" -DDBG_TRACE_GEMM_CTRL"
# CONFIGS+=" -DVCD_OUTPUT"

export VERILATOR_SEED=$((RANDOM + 1))

DEBUG_LEVEL=0
PERF_LEVEL=3

if [[ "${DEBUG_LEVEL}" -eq 0 ]]; then
  if [[ "${CONFIGS}" == *"-DVCD_OUTPUT"* ]]; then
    # drop VCD_OUTPUT if DEBUG_LEVEL is 0, since it generates huge log files and isn't useful without debug messages
    CONFIGS="${CONFIGS//-DVCD_OUTPUT/}"
  fi
fi

export CONFIGS

case "${mode}" in
  rtlsim)
    DRIVER=rtlsim \
    DEBUG_LEVEL=${DEBUG_LEVEL} \
    bash tests/regression/fpint_gemm_ffn_hw/test.sh "$@"
    ;;
  xrtsim)
    DRIVER=xrt \
    DEBUG_LEVEL=${DEBUG_LEVEL} \
    PERF_LEVEL=${PERF_LEVEL} \
    bash tests/regression/fpint_gemm_ffn_hw/test.sh "$@"
    ;;
  xrt-vcs-sim)
    DRAM_REQ_STALL_P_ENTER_PCT=0 \
    DRAM_REQ_STALL_P_EXIT_PCT=50 \
    DRAM_RSP_STALL_P_ENTER_PCT=0 \
    DRAM_RSP_STALL_P_EXIT_PCT=50 \
    DRAM_STALL_SEED=1234 \
    DRIVER=xrt_vcs \
    FSDB_DUMP=1 \
    DEBUG_AXI=1 \
    DEBUG_LEVEL=${DEBUG_LEVEL} \
    PERF_LEVEL=${PERF_LEVEL} \
    bash tests/regression/fpint_gemm_ffn_hw/test.sh "$@"
    ;;
  xrt-vcs-pgsim)
    DRAM_REQ_STALL_P_ENTER_PCT=0 \
    DRAM_REQ_STALL_P_EXIT_PCT=50 \
    DRAM_RSP_STALL_P_ENTER_PCT=0 \
    DRAM_RSP_STALL_P_EXIT_PCT=50 \
    DRAM_STALL_SEED=1234 \
    DRIVER=xrt_vcs \
    FSDB_DUMP=1 \
    DEBUG_AXI=1 \
    DEBUG_LEVEL=${DEBUG_LEVEL} \
    PERF_LEVEL=${PERF_LEVEL} \
    bash tests/regression/fpint_gemm_ffn_hw/test.sh "$@"
    ;;
  hw_emu)
    FPGA_BIN_DIR=/home/jaeyongjang/project.local/vortex/build/hw/syn/xilinx/xrt/hw_emu/bin \
    TARGET=hw_emu \
    PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1 \
    DRIVER=xrt \
    DEBUG_LEVEL=${DEBUG_LEVEL} \
    PERF_LEVEL=${PERF_LEVEL} \
    bash tests/regression/fpint_gemm_ffn_hw/test.sh "$@"
    ;;
  hw)
    FPGA_BIN_DIR=/home/jaeyongjang/project.local/vortex/build/hw/syn/xilinx/xrt/c1_f100_fpint_perf_xilinx_u55c_gen3x16_xdma_3_202210_1_hw/bin \
    TARGET=hw \
    PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1 \
    DRIVER=xrt \
    CHIPSCOPE=1 \
    DEBUG_LEVEL=${DEBUG_LEVEL} \
    bash tests/regression/fpint_gemm_ffn_hw/test.sh "$@"
    ;;
  *)
    echo "Unknown mode: ${mode}"
    exit 1
    ;;
esac